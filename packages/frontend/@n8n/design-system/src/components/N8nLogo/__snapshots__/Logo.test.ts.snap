// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Logo > renders the logo for authView location 1`] = `"<div class="logoContainer large" data-test-id="n8n-logo"><img class="brandLogo" src="/assets/logo-jworkflows.png" alt="jWorkflows"></div>"`;

exports[`Logo > renders the logo for sidebar location when sidebar is collapsed 1`] = `
"<div class="logoContainer sidebar sidebarCollapsed" data-test-id="n8n-logo"><svg xmlns="http://www.w3.org/2000/svg" width="50" height="30" viewBox="0 0 50 30" class="logo">
    <image width="50" height="30" href="data:image/png;base64,"></image>
  </svg>
  <!--v-if-->
</div>"
`;

exports[`Logo > renders the logo for sidebar location when sidebar is expanded 1`] = `
"<div class="logoContainer sidebar sidebarExpanded" data-test-id="n8n-logo"><svg xmlns="http://www.w3.org/2000/svg" width="50" height="30" viewBox="0 0 50 30" class="logo">
    <image width="50" height="30" href="data:image/png;base64,"></image>
  </svg><svg xmlns="http://www.w3.org/2000/svg" width="0" height="26" viewBox="0 0 0 26" class="logoText"></svg></div>"
`;
